{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nsc:reference-audit:request:1",
  "title": "neuroSEMANTICorr finite reference-audit request",
  "description": "Documentary JSON Schema. Standard-library runtime validation additionally checks hashes, cross-references, unique IDs, complete prediction domains, scope consistency and nonempty scored coverage. No jsonschema dependency is needed.",
  "$comment": "All runtime JSON numbers must be integers. Scores use rational strings. A valid observation excluding S_i produces OUT_OF_MODEL after validation; an originally empty S_i is an input error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "frame_id",
    "matrix",
    "model_scope",
    "observations",
    "budget",
    "threshold"
  ],
  "properties": {
    "schema": {
      "const": "nsc.reference-audit.request/1"
    },
    "frame_id": {
      "$ref": "#/$defs/identifier"
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalisation",
        "sha256",
        "payload"
      ],
      "properties": {
        "canonicalisation": {
          "const": "nsc-json-utf8-sort-keys-v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "conventions",
            "centres"
          ],
          "properties": {
            "cases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/case"
              }
            },
            "conventions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/convention"
              }
            },
            "centres": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/centre"
              }
            }
          }
        }
      }
    },
    "model_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "enumeration",
        "budget_scope"
      ],
      "properties": {
        "kind": {
          "enum": [
            "global",
            "contextwise",
            "casewise"
          ]
        },
        "enumeration": {
          "const": "explicit"
        },
        "budget_scope": {
          "const": "shared_total"
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "budget": {
      "type": "integer",
      "minimum": 0
    },
    "threshold": {
      "$ref": "#/$defs/rational"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}(?![\\s\\S])"
    },
    "rational": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(/[1-9][0-9]*)?(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "context_id",
        "role",
        "checker_labels",
        "allowed_labels",
        "weight",
        "exception_eligible"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "context_id": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "enum": [
            "frame",
            "external_query"
          ]
        },
        "checker_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "b"
          ],
          "properties": {
            "t": {
              "enum": [
                "S",
                "V",
                "U",
                null
              ]
            },
            "b": {
              "enum": [
                "S",
                "V",
                "U",
                null
              ]
            }
          }
        },
        "allowed_labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "S",
              "V",
              "U"
            ]
          },
          "uniqueItems": true
        },
        "weight": {
          "$ref": "#/$defs/rational"
        },
        "exception_eligible": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "frame"
              }
            }
          },
          "then": {
            "properties": {
              "checker_labels": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "t",
                  "b"
                ],
                "properties": {
                  "t": {
                    "enum": [
                      "S",
                      "V",
                      "U"
                    ]
                  },
                  "b": {
                    "enum": [
                      "S",
                      "V",
                      "U"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "weight": {
                "type": "string",
                "pattern": "^0(/[1-9][0-9]*)?(?![\\s\\S])"
              },
              "checker_labels": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "t",
                      "b"
                    ],
                    "properties": {
                      "t": {
                        "type": "null"
                      },
                      "b": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "t",
                      "b"
                    ],
                    "properties": {
                      "t": {
                        "enum": [
                          "S",
                          "V",
                          "U"
                        ]
                      },
                      "b": {
                        "enum": [
                          "S",
                          "V",
                          "U"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "convention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convention_id",
        "version",
        "predictions"
      ],
      "properties": {
        "convention_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "predictions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "enum": [
              "S",
              "V",
              "U"
            ]
          }
        }
      }
    },
    "centre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "centre_id",
        "convention_by_case"
      ],
      "properties": {
        "centre_id": {
          "$ref": "#/$defs/identifier"
        },
        "convention_by_case": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "label",
        "evidence"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "enum": [
            "S",
            "V",
            "U"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_id",
            "canonicalisation",
            "sha256",
            "payload"
          ],
          "properties": {
            "evidence_id": {
              "$ref": "#/$defs/identifier"
            },
            "canonicalisation": {
              "const": "nsc-json-utf8-sort-keys-v1"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "case_id",
                "label",
                "basis"
              ],
              "properties": {
                "case_id": {
                  "$ref": "#/$defs/identifier"
                },
                "label": {
                  "enum": [
                    "S",
                    "V",
                    "U"
                  ]
                },
                "basis": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  }
}
